FROM aisync-image-training-sdxl-lora-trainer:latest
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3-dev && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'transformers>=4.51,<5' 'peft>=0.13,<0.19' 'bitsandbytes>=0.46,<0.49' 'accelerate>=1,<2' 'jsonschema==4.26.0' 'httpx==0.28.1'
COPY pipeline/trainer_loop.py pipeline/train_candidate.py pipeline/tool_contracts.py /app/
ENTRYPOINT ["python", "/app/trainer_loop.py"]
