            "code"
          ],
          "input_schema": {
            "type": "object",
            "properties": {
              "booking_id": {
                "type": "string",
                "format": "uuid"
              },
              "code": {
                "type": "string",
                "pattern": "^\\d{6}$"
              }
            },
            "required": [
              "booking_id",
              "code"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        }
      ],
      "required_conversation_gates": [
        "Ask for service issue and service location.",
        "Use actual availability results and let the customer choose.",
        "Collect name, phone and address directly; public MCP cannot retrieve private customer history.",
        "Obtain explicit permission before request_booking and its SMS send.",
        "Use booking_id from the actual request result, and only the code the caller supplies.",
        "Only claim a confirmed appointment when the actual confirmation result has status=confirmed and booked=true."
      ],
      "review_status": "migration_plan_not_training_approved",
