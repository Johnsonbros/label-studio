{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cory Public Model SFT Record",
  "type": "object",
  "required": [
    "lane",
    "channel",
    "messages"
  ],
  "properties": {
    "lane": {
      "const": "cory_public"
    },
    "channel": {
      "enum": [
        "web",
        "phone",
        "sms",
        "tooluse",
        "safety_eval"
      ]
    },
    "source": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
