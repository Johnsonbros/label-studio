{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cory reviewed SFT record v2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cory_sft_record/2.0"
    },
    "lane": {
      "const": "cory_public"
    },
    "channel": {
      "enum": [
        "phone",
        "sms",
        "web"
      ]
    },
    "taxonomy_version": {
      "const": "1.0.0"
    },
    "topics": {
      "type": "object",
      "properties": {
        "primary": {
          "enum": [
            "drain_fixture_clog",
            "main_drain_backup",
            "water_heater",
            "leak_burst_shutoff",
            "sewer_odor",
            "sump_pump",
            "garbage_disposal",
            "service_area",
            "pricing_estimate",
            "booking_callback",
            "urgent_after_hours",
            "private_records",
            "prompt_injection_private_tools",
            "gas_immediate_danger",
            "company_information",
            "existing_appointment",
            "complaint_followup",
            "other_plumbing",
            "noncustomer_call",
            "unclassified"
          ]
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "drain_fixture_clog",
              "main_drain_backup",
              "water_heater",
              "leak_burst_shutoff",
              "sewer_odor",
              "sump_pump",
              "garbage_disposal",
              "service_area",
              "pricing_estimate",
              "booking_callback",
              "urgent_after_hours",
              "private_records",
              "prompt_injection_private_tools",
              "gas_immediate_danger",
              "company_information",
              "existing_appointment",
              "complaint_followup",
              "other_plumbing",
              "noncustomer_call",
              "unclassified"
            ]
          }
        }
      },
      "required": [
        "primary",
        "secondary"
      ],
      "additionalProperties": false
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "user"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "content"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "const": "assistant"
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "content"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "const": "assistant"
              },
              "content": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool_calls": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "const": "function"
                    },
                    "function": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "arguments": {
                          "type": "object"
                        }
                      },
                      "required": [
                        "name",
                        "arguments"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "function"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "role",
              "content",
              "tool_calls"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "const": "tool"
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "tool_call_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "content",
              "tool_call_id",
              "name"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "tools_available": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "inputSchema"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "group_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_kind": {
          "enum": [
            "archive_call",
            "live_call",
            "owner_test",
            "synthetic",
            "benchmark_fixture"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_status": {
          "enum": [
            "machine_draft",
            "human_approved",
            "human_rejected"
          ]
        },
        "training_eligible": {
          "type": "boolean"
        },
        "redaction_status": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "consent_review_status": {
          "enum": [
            "pending",
            "approved",
            "not_applicable"
          ]
        },
        "consent_basis": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "tokenizer_revision": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool_receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool_call_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "execution_kind": {
                "enum": [
                  "production",
                  "sandbox"
                ]
              }
            },
            "required": [
              "tool_call_id",
              "sha256",
              "execution_kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "source_id",
        "group_id",
        "source_kind",
        "reviewer",
        "reviewed_at",
        "review_status",
        "training_eligible",
        "redaction_status",
        "consent_review_status",
        "consent_basis",
        "model_id",
        "tokenizer_revision",
        "prompt_sha256",
        "tool_receipts"
      ],
      "additionalProperties": false
    },
    "eval_holdout": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "lane",
    "channel",
    "taxonomy_version",
    "topics",
    "messages",
    "tools_available",
    "contract_version",
    "tools",
    "provenance",
    "eval_holdout"
  ],
  "additionalProperties": false
}
